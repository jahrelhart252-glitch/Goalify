const {
  SlashCommandBuilder,
  EmbedBuilder
} = require("discord.js");

module.exports = {
  data: new SlashCommandBuilder()
    .setName("soccer")
    .setDescription("Soccer commands")
    .addSubcommand(subcommand =>
      subcommand
        .setName("leaderboard")
        .setDescription("Show the soccer leaderboard")
    ),

  async execute(interaction) {
    const leaderboard = [
      { rank: 1, name: "Manchester City", points: 87 },
      { rank: 2, name: "Liverpool", points: 82 },
      { rank: 3, name: "Arsenal", points: 78 },
      { rank: 4, name: "Chelsea", points: 71 },
      { rank: 5, name: "Manchester United", points: 65 }
    ];

    const description = leaderboard
      .map(team => `**${team.rank}. ${team.name}** — ${team.points} points`)
      .join("\n");

    const embed = new EmbedBuilder()
      .setTitle("⚽ Soccer Leaderboard")
      .setDescription(description)
      .setColor(0x00a651)
      .setTimestamp();

    await interaction.reply({ embeds: [embed] });
  }
};
